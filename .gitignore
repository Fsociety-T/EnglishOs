# Dependencies are never installed locally on purpose - the cloud build
# (GitHub Actions) is what runs `npm ci`. See README.
node_modules/

# Build output
dist/
dist-ssr/
.vite/

# Local env - secrets live in GitHub repository secrets instead
.env
.env.local
.env.*.local

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*

# Android signing. The keystore IS the app's identity: anyone holding it can
# ship an update Android accepts as genuine, and losing it means never being
# able to update the installed app again. It lives in GitHub secrets only.
*.keystore
*.jks
KEYSTORE_SECRETS.txt
android.keystore.base64.txt
android.keystore.password.txt

# Android build output. The `android/` project itself IS committed - Capacitor
# treats it as source you are meant to edit, and the signing config lives in
# it - so only what Gradle and `cap sync` produce is ignored. Most of that is
# already covered by android/.gitignore.
#
# Nothing here may be an unanchored `gradlew` or `build.gradle`: those match at
# every level and would quietly ignore the real project.
android/local.properties
*.apk
*.aab

