# Dependencies are never installed locally on purpose - the cloud build
# (GitHub Actions) is what runs `npm ci`. See README.
node_modules/

# Build output
dist/
dist-ssr/
.vite/

# Local env - secrets live in GitHub repository secrets instead
.env
.env.local
.env.*.local

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*

# Android signing. The keystore IS the app's identity: anyone holding it can
# ship an update Android accepts as genuine, and losing it means never being
# able to update the installed app again. It lives in GitHub secrets only.
*.keystore
*.jks
KEYSTORE_SECRETS.txt
android.keystore.base64.txt
android.keystore.password.txt

# Android project generated by `bubblewrap update` during the APK workflow
/app/
/gradle/
gradlew
gradlew.bat
build.gradle
settings.gradle
store_icon.png
*.apk
*.aab

