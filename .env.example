# Copy to .env.local for local development. In production these are injected
# by GitHub Actions from repository secrets (Settings > Secrets and variables >
# Actions). Never commit real values.

# Supabase (added in Phase 10). Leave both blank to run in demo mode, where
# data is stored in the browser's localStorage and no account is needed.
# The anon key is safe to expose in a client bundle - Row Level Security is
# what actually protects the data. Never put the service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# AI provider: "mock" returns canned feedback for building the UI,
# "claude" calls the real Anthropic API (added in Phase 11).
VITE_AI_PROVIDER=mock
